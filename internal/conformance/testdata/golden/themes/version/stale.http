# GET /resources/aaaaa/login/keycloak.v2/css/styles.css
# recorded-with: start-dev --health-enabled --metrics-enabled
HTTP/1.1 307 Temporary Redirect
Content-Length: {{volatile}}
Location: {{issuer}}/resources/{{theme_resource}}/login/keycloak.v2/css/styles.css
Referrer-Policy: no-referrer
Strict-Transport-Security: max-age=31536000; includeSubDomains
X-Content-Type-Options: nosniff
X-Robots-Tag: none

