# GET /health/ready
# recorded-with: start-dev --health-enabled
HTTP/1.1 200 OK
Cache-Control: no-store
Content-Length: {{volatile}}
Content-Type: application/json; charset=UTF-8

{
    "status": "UP",
    "checks": [{
            "name": "Graceful Shutdown",
            "status": "UP"
        },{
            "name": "Keycloak Initialized",
            "status": "UP"
        }]
}